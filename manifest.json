{
  "manifest_version": 3,
  "name": "텍스트 자동 변환기",
  "version": "1.0.0",
  "description": "입력 중 ..→…, ->→→, <-→←, --→— 같은 기호와 낫표/화살괄호, !수식! 계산을 자동으로 변환해주는 확장 프로그램. 커스텀 변환 규칙도 지원합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "텍스트 자동 변환기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/defaults.js", "lib/calc.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
